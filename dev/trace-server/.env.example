# .env.example — generated by scripts/gen_env_example.py. Do not edit by hand.
#
# Copy to .env and fill in the real values:   cp .env.example .env
# Any key showing `changeme` has no default and must be set — the server refuses to
# start otherwise. Every other value below is the development default.
# .env is git-ignored. This file is committed, so it must never hold a real secret.

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------

APP_ENV=development
PACKAGE_NAME=Trace+ accounting

# --------------------------------------------------------------------------
# Super admin
# --------------------------------------------------------------------------

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_HASH=changeme
SUPER_ADMIN_MOBILE_NO=98888888888
SUPER_ADMIN_UID=superAdmin

# --------------------------------------------------------------------------
# JWT
# --------------------------------------------------------------------------

ACCESS_TOKEN_EXPIRE_HOURS=24
ACCESS_TOKEN_EXPIRE_SECONDS_TEST=10
ACCESS_TOKEN_SECRET_KEY=changeme
ALGORITHM=HS256

# --------------------------------------------------------------------------
# Database (security database)
# --------------------------------------------------------------------------

DB_HOST=localhost
DB_INTERNAL_PORT=5432
DB_IP_ADDRESS=127.0.0.1
DB_NAME=traceAuth
DB_PASSWORD=changeme
DB_PORT=5432
DB_USER=webadmin

# --------------------------------------------------------------------------
# Crypto
# --------------------------------------------------------------------------

CRYPTO_KEY=changeme

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------

MAIL_FROM=admin@example.com
MAIL_PASSWORD=changeme
MAIL_PORT=587
MAIL_SERVER=localhost
MAIL_USER_NAME=admin@example.com

# --------------------------------------------------------------------------
# Integration
# --------------------------------------------------------------------------

SERVICE_PLUS_API_KEY=changeme
